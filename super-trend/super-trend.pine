//@version=6
strategy("Supertrend Strategy", overlay=true, process_orders_on_close=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// Inputs
atrPeriod = input.int(10,    "ATR Length", minval=1)
factor    = input.float(3.0, "Factor",     minval=0.01, step=0.01)

// Calculate Supertrend
[supertrend, direction] = ta.supertrend(factor, atrPeriod)

// Entry when Supertrend flips from red to green
longCondition = ta.crossunder(direction, 0)
if longCondition
    strategy.entry("Long", strategy.long)

// Exit when Supertrend flips from green to red
exitCondition = ta.crossover(direction, 0)
if exitCondition
    strategy.close("Long")

// Plot Supertrend lines (no indent before plot)
plot(direction < 0 ? supertrend : na, "Up Trend",   color=color.green, style=plot.style_linebr)
plot(direction > 0 ? supertrend : na, "Down Trend", color=color.red,   style=plot.style_linebr)
